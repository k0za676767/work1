#include <iostream>
using namespace std;

int main() {
    setlocale(LC_ALL, "");
    double a, b;
    char operation;
    cout << "Введите первое число: ";
    cin >> a;
    cout << "Введите операцию (+, -, *, /): ";
    cin >> operation;
    cout << "Введите второе число: ";
    cin >> b;

    switch (operation) {
    case '+': cout << "Результат: " << a + b << endl; break;
    case '-': cout << "Результат: " << a - b << endl; break;
    case '*': cout << "Результат: " << a * b << endl; break;
    case '/': if (b != 0) cout << "Результат: " << a / b << endl;
            else cout << "Ошибка: деление на ноль!" << endl;
    default: cout << "Неверная операция!" << endl;
    }
    return 0;
}
